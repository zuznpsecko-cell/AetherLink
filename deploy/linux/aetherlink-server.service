[Unit]
Description=AetherLink VPN server (selmedia.ru)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Public-trust wildcard, see scripts/provision_cert_ubuntu.sh
Environment=TLS_CERT=/etc/letsencrypt/live/selmedia.ru-wildcard/fullchain.pem
Environment=TLS_KEY=/etc/letsencrypt/live/selmedia.ru-wildcard/privkey.pem
ExecStart=/opt/aetherlink/server/AetherLink.Server /opt/aetherlink/server.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
