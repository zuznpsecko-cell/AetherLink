[Unit]
Description=AetherLink VPN server (selmedia.ru)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# TLS paths live inside /opt/aetherlink/server.yaml (absolute); installers
# resolve them (LE wildcard via provision_cert_ubuntu.sh, self-signed fallback).
ExecStart=/opt/aetherlink/server/AetherLink.Server /opt/aetherlink/server.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
