# Keep line endings sane across Windows/Linux checkouts.
* text=auto
*.sh text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.service text eol=lf
