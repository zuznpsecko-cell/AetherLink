<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherLink.Gui.ViewModels"
        xmlns:models="using:AetherLink.Gui.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="AetherLink.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AetherLink" Width="640" Height="520">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="20" FontWeight="Bold" />
                <Button Grid.Row="0" Grid.Column="1" Content="{Binding ConnectLabel}"
                        Command="{Binding ConnectDisconnectCommand}"
                        Padding="24,8" />
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding EgressIp, StringFormat='Egress: {0}'}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding LastError}" Foreground="Red"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TabControl>
            <TabItem Header="Server">
                <Grid ColumnDefinitions="200,*" Margin="4">
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                            <Button Content="Add" Command="{Binding AddEndpointCommand}"
                                    IsEnabled="{Binding CanEditEndpoints}"
                                    HorizontalAlignment="Stretch" />
                            <Button Content="Duplicate" Command="{Binding DuplicateEndpointCommand}"
                                    IsEnabled="{Binding CanEditEndpoints}"
                                    HorizontalAlignment="Stretch" />
                            <Button Content="Delete" Command="{Binding DeleteEndpointCommand}"
                                    IsEnabled="{Binding CanDeleteEndpoint}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Endpoints}"
                                 SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}"
                                 IsEnabled="{Binding CanEditEndpoints}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:EndpointProfile">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ServerAddr}" FontSize="11"
                                                   Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Endpoint" FontWeight="Bold" />
                            <StackPanel Spacing="8" IsEnabled="{Binding HasSelection}">
                                <TextBlock Text="Name" />
                                <TextBox Text="{Binding SelectedEndpoint.Name, Mode=TwoWay}" />
                                <TextBlock Text="Server address (host:port)" />
                                <TextBox Text="{Binding SelectedEndpoint.ServerAddr, Mode=TwoWay}" />
                                <TextBlock Text="Outer SNI (empty = server host)" />
                                <TextBox Text="{Binding SelectedEndpoint.OuterSni, Mode=TwoWay}" />
                                <TextBlock Text="PSK (base64)" />
                                <TextBox Text="{Binding SelectedEndpoint.Psk, Mode=TwoWay}"
                                         PasswordChar="*" />
                            </StackPanel>
                            <TextBlock Text="Selecting another profile while connected reconnects the tunnel."
                                       FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="Shared settings" FontWeight="Bold" Margin="0,8,0,0" />
                            <CheckBox Content="Full tunnel" IsChecked="{Binding FullTunnel}" />
                            <TextBlock Text="DNS mode" />
                            <TextBox Text="{Binding DnsMode}" />
                            <TextBlock Text="{Binding ConfigPath, StringFormat='Config: {0}'}" FontSize="11" />
                            <Button Content="Refresh egress IP" Command="{Binding RefreshEgressCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="After a crash or forced shutdown the network may still point into the tunnel. Restore it before reconnecting." FontSize="11" TextWrapping="Wrap" />
                            <Button Content="Restore network" Command="{Binding RestoreNetworkCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Routes">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4">
                        <Button Content="Add rule" Command="{Binding AddRuleCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rules}" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90" />
                            <DataGridTextColumn Header="Match" Binding="{Binding WhenKind}" Width="90" />
                            <DataGridTextColumn Header="Value" Binding="{Binding WhenValue}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Del"
                                                Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).RemoveRuleCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Logs">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Reload latest log"
                            Command="{Binding ReloadLogsCommand}"
                            HorizontalAlignment="Left" Margin="4" />
                    <ScrollViewer Margin="4">
                        <TextBox Text="{Binding LogText}" IsReadOnly="True"
                                 FontFamily="Consolas,Monospace" FontSize="11"
                                 AcceptsReturn="True" TextWrapping="NoWrap" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
